{% from "components/icon.njk" import icon %}
<header id="header">
  <div class="topbar">
    <div class="container">
      <div>Официальный партнёр Poritep в Нижнем Новгороде</div>
      <div class="topbar-info"><span>Пн–Пт 9:00–18:00</span><a href="mailto:89200200370@bogart.su">89200200370@bogart.su</a></div>
    </div>
  </div>
  <div class="main-header">
    <div class="container header-main">
      <button class="menu-button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobileNav">{{ icon("menu") }}</button>
      <a class="brand" href="index.html"><img src="assets/poritep-logo.png" alt="Poritep"><small>официальный<br>партнёр</small></a>
      <a class="catalog-button" href="catalog.html">{{ icon("layout-grid") }}Каталог</a>
      <div class="search-wrap">
        <form class="search"><input id="searchInput" placeholder="Поиск по каталогу"><button aria-label="Найти">{{ icon("search") }}</button></form>
        <div class="search-results" id="searchResults"></div>
      </div>
      <div class="header-actions">
        <a href="contacts.html">{{ icon("headset") }}Консультация</a>
        <a class="cart-link" href="cart.html">{{ icon("shopping-cart") }}<span class="cart-count">0</span>Корзина</a>
      </div>
    </div>
    <div class="container nav-row">
      <nav>
        <a class="{% if pageClass == 'home' %}active{% endif %}" href="index.html">Главная</a>
        <a class="{% if pageClass == 'catalog' %}active{% endif %}" href="catalog.html">Продукция</a>
        <a class="{% if pageClass == 'delivery' %}active{% endif %}" href="delivery.html">Доставка</a>
        <a class="{% if pageClass == 'objects' %}active{% endif %}" href="objects.html">Объекты</a>
        <a class="{% if pageClass == 'about' %}active{% endif %}" href="about.html">О компании</a>
        <a class="{% if pageClass == 'contacts' %}active{% endif %}" href="contacts.html">Контакты</a>
        <a class="{% if pageClass == 'calculator' %}active{% endif %}" href="calculator.html">Калькулятор</a>
      </nav>
      <a class="nav-phone" href="tel:+78312621280"><span>Позвонить</span>+7 (831) 262-12-80</a>
    </div>
    <nav class="container mobile-nav" id="mobileNav"><a href="catalog.html">Каталог продукции</a><a href="delivery.html">Доставка</a><a href="objects.html">Объекты</a><a href="about.html">О компании</a><a href="calculator.html">Калькулятор</a><a href="contacts.html">Контакты</a><a href="cart.html">Корзина</a></nav>
  </div>
</header>
